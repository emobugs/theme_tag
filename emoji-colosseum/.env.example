# Потребителско име в TikTok (без @). Ако е празно, bridge-ът пуска симулатор.
TIKTOK_USERNAME=
# По избор: API ключ от eulerstream.com (sign server). Без ключ работи с безплатния лимит.
EULER_API_KEY=
# Порт на WebSocket bridge-а
BRIDGE_PORT=8787
# sim = винаги симулатор, tiktok = само TikTok, auto = TikTok ако има username
MODE=auto
