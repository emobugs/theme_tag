# Попълни една или повече платформи. Може и трите наведнъж (мултистрийм в една арена).
# Ако всички са празни, bridge-ът пуска симулирани зрители.

# TikTok: потребителско име без @. Не трябва парола.
TIKTOK_USERNAME=
# Twitch: име на канала или линк (twitch.tv/канал). Не трябва акаунт или ключ.
TWITCH_CHANNEL=
# YouTube: @handle, линк към канала или линк/ID на конкретен лайф. Не трябва API ключ.
YOUTUBE_CHANNEL=

# По избор: API ключ от eulerstream.com за TikTok (ако безплатният лимит спре да стига).
EULER_API_KEY=
# Порт на bridge-а
BRIDGE_PORT=8787
# auto = платформите отгоре (или симулатор, ако няма), sim = винаги симулатор
MODE=auto
